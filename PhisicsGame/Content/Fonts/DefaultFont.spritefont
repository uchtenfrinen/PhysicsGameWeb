<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>20</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <!-- ASCII -->
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- Полный блок кириллицы U+0400–U+04FF (все буквы RU/UA и т.д.) -->
      <CharacterRegion>
        <Start>&#1024;</Start>
        <End>&#1279;</End>
      </CharacterRegion>
      <!-- Latin-1 Supplement: ° ² ³ « » и др. (часто в формулах и типографике) -->
      <CharacterRegion>
        <Start>&#160;</Start>
        <End>&#255;</End>
      </CharacterRegion>
      <!-- Общая пунктуация: длинное/короткое тире, многоточие и т.д. -->
      <CharacterRegion>
        <Start>&#8192;</Start>
        <End>&#8303;</End>
      </CharacterRegion>
      <!-- Математические операторы: ∫ ∑ √ и т.п. (U+2200–U+22FF) -->
      <CharacterRegion>
        <Start>&#8704;</Start>
        <End>&#8959;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
