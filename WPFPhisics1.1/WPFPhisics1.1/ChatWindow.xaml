<Window x:Class="WPFPhisics1._1.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат с нейросетью"
        Height="420" Width="380"
        MinHeight="320" MinWidth="320"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Вопрос нейросети:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QuestionBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Отправить" Click="SendButton_Click" Padding="18,10" FontSize="13" FontWeight="SemiBold"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="Ответ:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,6"/>
        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ResponseText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
