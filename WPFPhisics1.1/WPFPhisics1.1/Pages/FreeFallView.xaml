<UserControl x:Class="WPFPhisics1._1.Pages.FreeFallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFPhisics1._1"
             mc:Ignorable="d"
             d:DesignHeight="732" d:DesignWidth="1280">
    <UserControl.Resources>
        <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#AA202637" Offset="0"/>
                        <GradientStop Color="#AA171B28" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#3A4C66"/>
        </Style>
        <Style x:Key="MiniChartBorder" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinHeight" Value="168"/>
        </Style>
        <Style x:Key="ParamCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinWidth" Value="170"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#F2F8FF"/>
            <Setter Property="BorderBrush" Value="#4A6A92"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10" Background="#171A23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="BackBtn" Content="← К списку установок" Style="{StaticResource BackButtonStyle}" Padding="10,6" HorizontalAlignment="Left" Click="BackBtn_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Свободное падение" FontSize="34" FontWeight="SemiBold" Foreground="#F1F7FF"/>
            <TextBlock Text="Физическая лаборатория" FontSize="16" Foreground="#8EA1BE" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Margin="0,0,8,0">
                    <Border Style="{StaticResource ParamCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="⇅ Начальная высота h₀ (м)" Foreground="#CDE2FF"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="h₀" Foreground="#8FB4E7" Margin="0,0,8,0"/>
                                <TextBox Width="74" Text="{Binding Height0, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDouble}, ConverterParameter=N1}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ParamCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="⚖ Масса груза m (кг)" Foreground="#CDE2FF"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="m" Foreground="#8FB4E7" Margin="0,0,8,0"/>
                                <TextBox Width="74" Text="{Binding MassKg, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDouble}, ConverterParameter=N2}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel>
                            <TextBlock Text="⚙ Расширенные настройки" Foreground="#CDE2FF"/>
                            <TextBlock Text="Модель без сопротивления воздуха; g = 9.81 м/с²" Foreground="#8FA9CA" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <StackPanel Grid.Column="1">
                    <Button Content="↑ Построить траекторию" Command="{Binding BuildCommand}" Style="{StaticResource ActionButton}" Background="#0E639C" BorderBrush="#2FA2FF"/>
                    <Button Content="🧠 Объяснить (нейросеть)" Command="{Binding ExplainGroqCommand}" Style="{StaticResource ActionButton}" Background="#5C2D91" BorderBrush="#C586F0" Foreground="#F4ECFF"/>
                    <Button Command="{Binding PlayAnimationCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                <Setter Property="Background" Value="#128A43"/>
                                <Setter Property="BorderBrush" Value="#56D981"/>
                                <Setter Property="Content" Value="▶ Запустить анимацию"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Background" Value="#B33B3B"/>
                                        <Setter Property="BorderBrush" Value="#FF8A8A"/>
                                        <Setter Property="Content" Value="■ Остановить анимацию"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" MinHeight="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="288" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Мини-графики -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="h(t) (м) vs t (с)" Foreground="#8EA1BE" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <Border Style="{StaticResource MiniChartBorder}" Margin="0,0,0,10">
                    <local:FreeFallChartControl DataContext="{Binding}" IsVelocityChart="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="180"/>
                </Border>
                <TextBlock Text="v(t) (м/с) vs t (с)" Foreground="#8EA1BE" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <Border Style="{StaticResource MiniChartBorder}">
                    <local:FreeFallChartControl DataContext="{Binding}" IsVelocityChart="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="180"/>
                </Border>
            </StackPanel>

            <!-- Центральная схема -->
            <Border Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource GlassCard}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="Схема падения" FontWeight="SemiBold" FontSize="17" Foreground="#F1F7FF" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#8EA1BE" FontSize="13"
                                   Text="{Binding TimeOfFall, StringFormat='T = {0:F2} с'}"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#12151E" CornerRadius="8" Padding="2">
                        <Border BorderBrush="#5A3D8A" BorderThickness="1" CornerRadius="6" Background="Transparent">
                            <local:FreeFallCanvas DataContext="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="280"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- Результаты -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Результаты полёта" FontSize="18" FontWeight="SemiBold" Foreground="#F1F7FF" Margin="0,0,0,10"/>

                        <TextBlock Foreground="#C7DAF4"><Run Text="⏱ Время падения T (с): "/><Run Text="{Binding TimeOfFall, Mode=OneWay, StringFormat=F2}" Foreground="#85E9FF" FontWeight="Bold"/></TextBlock>
                        <TextBlock Foreground="#C7DAF4" Margin="0,6,0,0"><Run Text="🎯 Тек. скорость v (м/с): "/><Run Text="{Binding CurrentSpeed, Mode=OneWay, StringFormat=F2}" Foreground="#7AF09A" FontWeight="Bold"/></TextBlock>
                        <TextBlock Foreground="#C7DAF4" Margin="0,6,0,0"><Run Text="📍 Место приземления: "/><Run Text="0" Foreground="#FFE16C" FontWeight="Bold"/><Run Text=" м" Foreground="#FFE16C" FontWeight="Bold"/></TextBlock>
                        <TextBlock Foreground="#C7DAF4" Margin="0,6,0,0"><Run Text="📟 Состояние: "/><Run Text="{Binding MotionStateText, Mode=OneWay}" Foreground="#FFB366" FontWeight="Bold"/></TextBlock>
                        <TextBlock Foreground="#9CB4D6" Margin="0,6,0,0" FontSize="12">
                            <Run Text="v при ударе: "/><Run Text="{Binding FinalSpeed, Mode=OneWay, StringFormat=F2}"/><Run Text=" м/с"/>
                        </TextBlock>

                        <Expander Header="Формулы" Margin="0,14,0,0" IsExpanded="True" Foreground="#DCEBFF">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="h(t) = h₀ − gt²/2" Foreground="#C7DAF4"/>
                                <TextBlock Text="v(t) = gt" Foreground="#C7DAF4" Margin="0,4,0,0"/>
                                <TextBlock Text="T = √(2h₀/g)" Margin="0,4,0,0" Foreground="#C7DAF4"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource GlassCard}" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="128" MinHeight="80"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Объяснение" FontSize="16" FontWeight="SemiBold" Foreground="#F1F7FF" Margin="2,2,40,6"/>
                <TextBlock Grid.Row="0" Text="⚙" FontSize="28" Foreground="#7F90AD" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="2,0,2,2">
                    <TextBox Text="{Binding ExplanationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" BorderThickness="0" Foreground="#D5E8FF" Background="Transparent" Padding="0"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
