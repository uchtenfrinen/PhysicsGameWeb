<UserControl
    x:Class="WPFPhisics1._1.Pages.InclinedPlaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFPhisics1._1"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="GlassCard"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#AA202637" />
                        <GradientStop Offset="1" Color="#AA171B28" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#3A4C66" />
        </Style>
        <Style
            x:Key="ParamCard"
            BasedOn="{StaticResource GlassCard}"
            TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="MinWidth" Value="170" />
        </Style>
        <Style
            x:Key="ActionButton"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Foreground" Value="#F2F8FF" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="10" Background="#171A23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Button
                x:Name="BackBtn"
                Padding="10,6"
                HorizontalAlignment="Left"
                Click="BackBtn_Click"
                Content="← К списку установок"
                Style="{StaticResource BackButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="#F1F7FF"
                Text="Наклонная плоскость" />
            <TextBlock
                Margin="0,0,0,10"
                FontSize="16"
                Foreground="#8EA1BE"
                Text="Физическая лаборатория" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Margin="0,0,8,0">
                    <Border Margin="0,0,8,0" Style="{StaticResource ParamCard}">
                        <StackPanel>
                            <TextBlock Foreground="#CDE2FF" Text="⚖ Масса груза m (кг)" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    Foreground="#8FB4E7"
                                    Text="m" />
                                <TextBox Width="74" Text="{Binding MassKg, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDouble}, ConverterParameter=N1}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Style="{StaticResource ParamCard}">
                        <StackPanel>
                            <TextBlock Foreground="#CDE2FF" Text="∡ Угол наклона α (°)" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    Foreground="#8FB4E7"
                                    Text="α" />
                                <TextBox Width="74" Text="{Binding AngleDegrees, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDouble}, ConverterParameter=N0}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Style="{StaticResource ParamCard}">
                        <StackPanel>
                            <TextBlock Foreground="#CDE2FF" Text="≈ Коэффициент трения μ" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    Foreground="#8FB4E7"
                                    Text="μ" />
                                <TextBox Width="74" Text="{Binding FrictionMu, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDouble}, ConverterParameter=N2}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel>
                            <TextBlock Foreground="#CDE2FF" Text="⚙ Расширенные параметры" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="#8FA9CA"
                                Text="---" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <StackPanel Grid.Column="1">
                    <Button BorderBrush="#56D981" Command="{Binding StartStopCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource ActionButton}" TargetType="Button">
                                <Setter Property="Background" Value="#128A43" />
                                <Setter Property="Content" Value="▶ Запустить симуляцию" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="#B33B3B" />
                                        <Setter Property="BorderBrush" Value="#FF8A8A" />
                                        <Setter Property="Content" Value="■ Остановить симуляцию" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        Background="#0E639C"
                        BorderBrush="#2FA2FF"
                        Command="{Binding ResetCommand}"
                        Content="↻ Сброс"
                        Style="{StaticResource ActionButton}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!--  Три колонки: графики слева | установка (крупно) | панель сил справа  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,10,0"
                Padding="8"
                Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Margin="0"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid
                            x:Name="PlaneChartGrid"
                            Background="#2D2D30"
                            ClipToBounds="True">
                            <lvc:CartesianChart x:Name="InclinedPlaneChart" Series="{Binding InclinedPlaneSeries}" />
                            <Border
                                x:Name="PlaneDragOverlay"
                                Background="Transparent"
                                IsHitTestVisible="True"
                                MouseLeave="PlaneDragOverlay_MouseLeave"
                                MouseLeftButtonDown="PlaneDragOverlay_MouseLeftButtonDown"
                                MouseLeftButtonUp="PlaneDragOverlay_MouseLeftButtonUp"
                                MouseMove="PlaneDragOverlay_MouseMove" />
                            <StackPanel
                                Margin="6,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#D8E8FF"
                                    Text="s(t)" />
                                <TextBlock
                                    Margin="0,36,0,0"
                                    FontSize="12"
                                    Foreground="#D8E8FF"
                                    Text="v(t)" />
                                <TextBlock
                                    Margin="0,38,0,0"
                                    FontSize="12"
                                    Foreground="#D8E8FF"
                                    Text="a(t)" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Foreground="#D8E8FF"
                                Text="t (с)" />
                            <TextBlock
                                Margin="6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                FontSize="22"
                                Foreground="#8AB7FF"
                                Text="✦" />
                            <TextBlock
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="26"
                                Foreground="#8AB7FF"
                                Text="⚙" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#F1F7FF"
                            Text="Результаты" />
                        <TextBlock Foreground="#C7DAF4"><Run Text="🔻 Сила тяжести Fт (Н): " /><Run
                                FontWeight="Bold"
                                Foreground="#85E9FF"
                                Text="{Binding FWeight, Mode=OneWay, StringFormat=F1}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="#C7DAF4"><Run Text="⬇ Нормаль N (Н): " /><Run
                                FontWeight="Bold"
                                Foreground="#B3E18A"
                                Text="{Binding NormalN, Mode=OneWay, StringFormat=F1}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="#C7DAF4"><Run Text="↔ Сила трения Fтр (Н): " /><Run
                                FontWeight="Bold"
                                Foreground="#FFB366"
                                Text="{Binding FTr, Mode=OneWay, StringFormat=F1}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="#C7DAF4"><Run Text="→ Ускорение a (м/с²): " /><Run
                                FontWeight="Bold"
                                Foreground="#FFE16C"
                                Text="{Binding Acceleration, Mode=OneWay, StringFormat=F2}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="#C7DAF4"><Run Text="⏱ Время пути (1 м): " /><Run
                                FontWeight="Bold"
                                Foreground="#A8D7FF"
                                Text="{Binding TimeFor1MText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="#C7DAF4"><Run Text="ℹ Состояние: " /><Run
                                FontWeight="Bold"
                                Foreground="#FFB366"
                                Text="{Binding StateDisplayText, Mode=OneWay}" /></TextBlock>

                        <Expander
                            Margin="0,12,0,0"
                            Foreground="#DCEBFF"
                            Header="Схема сил"
                            IsExpanded="True">
                            <Border
                                Height="140"
                                MinHeight="100"
                                Margin="0,6,0,0"
                                Background="#2D2D30"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="4">
                                <local:MiniSchemeControl
                                    x:Name="MiniScheme"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    DataContext="{Binding}" />
                            </Border>
                        </Expander>

                        <Expander
                            Margin="0,10,0,0"
                            Foreground="#DCEBFF"
                            Header="Формулы"
                            IsExpanded="True">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Foreground="#C7DAF4" Text="Fт = mg, a = g(sin α - μ cos α)" />
                                <TextBlock Foreground="#C7DAF4" Text="N = mg cos α" />
                                <TextBlock Foreground="#C7DAF4" Text="Сила трения Fтр = μN" />
                                <TextBlock Foreground="#C7DAF4" Text="Ускорение a (м/с²)" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="#9CB4D6"
                                    Text="{Binding RestConditionText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontStyle="Italic"
                                    Foreground="#9CB4D6"
                                    Text="{Binding LastRunSummaryText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="0,10,0,0"
            Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" MinHeight="80" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="2,2,40,6"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#F1F7FF"
                    Text="Объяснение" />
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="28"
                    Foreground="#7F90AD"
                    Text="⚙" />
                <ScrollViewer
                    Grid.Row="1"
                    Margin="2,0,2,2"
                    VerticalScrollBarVisibility="Auto">
                    <TextBox
                        Padding="0"
                        AcceptsReturn="True"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="#CCCCCC"
                        FontSize="14"
                        Foreground="#D5E8FF"
                        IsReadOnly="True"
                        Text="{Binding ExplanationText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
