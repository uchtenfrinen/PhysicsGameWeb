<UserControl
    x:Class="WPFPhisics1._1.Pages.MainMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFPhisics1._1.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="clr-namespace:WPFPhisics1._1.Navigation"
    d:DesignHeight="400"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="#171A23">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" Margin="32">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Физическая лаборатория" />
                <TextBlock
                    Margin="0,0,0,28"
                    FontSize="15"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Выберите раздел физики" />

                <ItemsControl x:Name="SectionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type nav:PhysicsSection}">
                            <Button
                                Margin="0,0,0,14"
                                Padding="22,16"
                                HorizontalContentAlignment="Left"
                                Background="#AA1B1F2A"
                                BorderBrush="#3A4C66"
                                BorderThickness="1"
                                Click="SectionButton_Click"
                                Cursor="Hand"
                                FontSize="15"
                                FontWeight="Medium"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#22304A" />
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource NeonBlueBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
