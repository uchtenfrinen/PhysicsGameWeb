<UserControl x:Class="WPFPhisics1._1.Pages.CommunicatingVesselsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFPhisics1._1"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1280">
    <UserControl.Resources>
        <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#AA202637" Offset="0"/>
                        <GradientStop Color="#AA171B28" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#3A4C66"/>
        </Style>
        <Style x:Key="ParamCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#F2F8FF"/>
            <Setter Property="BorderBrush" Value="#4A6A92"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="NeonInner" TargetType="Border">
            <Setter Property="BorderBrush" Value="#4A6A92"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#151A24" Offset="0"/>
                        <GradientStop Color="#10141C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" Background="#171A23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="BackBtn" Grid.Row="0" Content="← К списку установок" Style="{StaticResource BackButtonStyle}" Padding="10,6" HorizontalAlignment="Left" Click="BackBtn_Click"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Foreground="#F1F7FF">
                <Run Text="Гармонический Конструктор – Жидкости" FontSize="28" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Text="Симуляция двух жидкостей" FontSize="15" Foreground="#8EA1BE" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" MinHeight="420">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="308" MinWidth="260"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="300" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: параметры + кнопки снизу -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ВХОДНЫЕ ПАРАМЕТРЫ" FontWeight="SemiBold" FontSize="14" Foreground="#9BB4D6" Margin="0,0,0,10"/>

                        <Border Style="{StaticResource ParamCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="💧 Тип жидкостей" Foreground="#CDE2FF" FontWeight="SemiBold"/>
                                <Border Margin="0,8,0,0" CornerRadius="8" Padding="10,8" BorderBrush="#2FA2FF" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#220E639C" Offset="0"/>
                                            <GradientStop Color="#335C2D91" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Две несмешивающиеся" Foreground="#EAF6FF" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ParamCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🛢 Жидкость 1 (масло) — ρ₁" Foreground="#CDE2FF"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="кг/м³" Foreground="#8FB4E7" VerticalAlignment="Center" Margin="8,0,0,0" DockPanel.Dock="Right"/>
                                    <TextBox VerticalContentAlignment="Center"
                                             Text="{Binding RhoLight, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDouble}, ConverterParameter=N0}"/>
                                </DockPanel>
                                <Slider Minimum="200" Maximum="1200" Value="{Binding RhoLight}" Margin="0,8,0,0" TickFrequency="50"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ParamCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="💧 Жидкость 2 (вода) — ρ₂" Foreground="#CDE2FF"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="кг/м³" Foreground="#8FB4E7" VerticalAlignment="Center" Margin="8,0,0,0" DockPanel.Dock="Right"/>
                                    <TextBox VerticalContentAlignment="Center"
                                             Text="{Binding RhoHeavy, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDouble}, ConverterParameter=N0}"/>
                                </DockPanel>
                                <Slider Minimum="800" Maximum="1200" Value="{Binding RhoHeavy}" Margin="0,8,0,0" TickFrequency="25"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="📏 Высота столба воды h₂" Foreground="#CDE2FF"/>
                                <TextBlock Text="(в правом колене, м)" Foreground="#8FA9CA" FontSize="11" Margin="0,2,0,0"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="м" Foreground="#8FB4E7" VerticalAlignment="Center" Margin="8,0,0,0" DockPanel.Dock="Right"/>
                                    <TextBox VerticalContentAlignment="Center"
                                             Text="{Binding HeightHeavy, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDouble}, ConverterParameter=G4}"/>
                                </DockPanel>
                                <Slider Minimum="0.02" Maximum="0.5" Value="{Binding HeightHeavy}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Content="〽 Построить график" Command="{Binding BuildCommand}" Style="{StaticResource ActionButton}" Background="#0E639C" BorderBrush="#2FA2FF"/>
                    <Button Content="🧠 Объяснить (нейросеть)" Command="{Binding ExplainGroqCommand}" Style="{StaticResource ActionButton}" Background="#5C2D91" BorderBrush="#C586F0" Foreground="#F4ECFF"/>
                    <Button Command="{Binding PlaySimulationCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                <Setter Property="Background" Value="#128A43"/>
                                <Setter Property="BorderBrush" Value="#56D981"/>
                                <Setter Property="Content" Value="▶ Запустить симуляцию"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Background" Value="#B33B3B"/>
                                        <Setter Property="BorderBrush" Value="#FF8A8A"/>
                                        <Setter Property="Content" Value="■ Остановить симуляцию"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Центр: схема + объяснение в одной неоновой рамке -->
            <Border Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource GlassCard}" Padding="10">
                <Border Style="{StaticResource NeonInner}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="420"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="128" MinHeight="100"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="СХЕМА УСТАНОВКИ" FontWeight="SemiBold" FontSize="15" Foreground="#9BB4D6" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="⬡" FontSize="16" Foreground="#5A6F90" Margin="0,0,6,0" Opacity="0.55"/>
                                <TextBlock Text="◆" FontSize="14" Foreground="#5A6F90" Margin="0,0,6,0" Opacity="0.55"/>
                                <TextBlock Text="⚛" FontSize="18" Foreground="#5A6F90" Margin="0,0,6,0" Opacity="0.55"/>
                                <TextBlock Text="⚙" FontSize="22" Foreground="#7F90AD"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="#12151E" CornerRadius="8" BorderBrush="#3A4C66" BorderThickness="1" Padding="4">
                            <local:CommunicatingVesselsCanvas x:Name="VesselsCanvas" DataContext="{Binding}"
                                                                 MinHeight="420" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <TextBlock Grid.Row="2" Text="ОБЪЯСНЕНИЕ НЕЙРОСЕТЬЮ" FontSize="15" FontWeight="SemiBold" Foreground="#F1F7FF" Margin="0,10,0,6"/>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding ExplanationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     AcceptsReturn="True" BorderThickness="0" Foreground="#D5E8FF" Background="Transparent" Padding="0" CaretBrush="#D5E8FF"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>

            <!-- Правая колонка -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="АНАЛИЗ И ФОРМУЛЫ" FontWeight="SemiBold" FontSize="15" Foreground="#F1F7FF" Margin="0,0,0,10"/>

                        <Border Background="#12151E" BorderBrush="#3A4C66" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ρ₁·h₁" Foreground="#85E9FF" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Foreground="#C7DAF4" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Run Text="{Binding RhoLight, StringFormat=N0}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding HeightLight, StringFormat=F3}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ρ₂·h₂" Foreground="#B3E18A" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Foreground="#C7DAF4" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Run Text="{Binding RhoHeavy, StringFormat=N0}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding HeightHeavy, StringFormat=F3}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Давление p₁" Foreground="#FFE16C" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Foreground="#C7DAF4" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Run Text="{Binding PressureAtInterface, StringFormat=N1}"/>
                                        <Run Text=" Па"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Foreground="#C7DAF4" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap">
                            <Run Text="h₁ / h₂ = "/>
                            <Run Text="{Binding RatioH1H2, Mode=OneWay, StringFormat=F3}" FontWeight="SemiBold" Foreground="#85E9FF"/>
                            <Run Text="  (ожидается ≈ "/>
                            <Run Text="{Binding RhoHeavy, Mode=OneWay, StringFormat=N0}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding RhoLight, Mode=OneWay, StringFormat=N0}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <TextBlock Text="ГРАФИКИ И ФОРМУЛЫ" FontWeight="SemiBold" FontSize="14" Foreground="#9BB4D6" Margin="0,4,0,8"/>
                        <TextBlock Text="Зависимость h₁(ρ₁) при заданной h₂ — текущее состояние в точке на кривой." FontSize="11" Foreground="#8EA1BE" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Border Background="#12151E" BorderBrush="#3A4C66" BorderThickness="1" CornerRadius="8" Height="200" Margin="0,0,0,10">
                            <lvc:CartesianChart Series="{Binding HeightSeries}" ZoomMode="X" LegendPosition="Top" Background="Transparent"/>
                        </Border>

                        <TextBlock Text="Формулы" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" Foreground="#C7DAF4" TextWrapping="Wrap">
                            <Run Text="ρ₁·h₁ = ρ₂·h₂"/><LineBreak/>
                            <Run Text="h₁ / h₂ = ρ₂ / ρ₁"/><LineBreak/>
                            <Run Text="p₁ = ρ₂·g·h₂ = ρ₁·g·h₁"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
