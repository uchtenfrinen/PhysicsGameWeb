<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="BgDeep">#FF050810</Color>
  <Color x:Key="BgPanel">#FF0D1422</Color>
  <Color x:Key="AccentCyan">#FF00E8FF</Color>
  <Color x:Key="TextPrimary">#FFEAF2FF</Color>
  <Color x:Key="TextMuted">#FF8DA0C4</Color>
  <Color x:Key="Danger">#FFFF5A7A</Color>
  <Color x:Key="Success">#FF4CFFB3</Color>

  <SolidColorBrush x:Key="Brush.BgDeep" Color="{StaticResource BgDeep}" />
  <SolidColorBrush x:Key="Brush.BgPanel" Color="{StaticResource BgPanel}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource AccentCyan}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource TextMuted}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Danger}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Success}" />

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Brush.BgDeep}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style TargetType="UserControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="#223EE2FF" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#FF0A121F" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="#6600E8FF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Background" Value="#FF0A121F" />
  </Style>

</ResourceDictionary>
