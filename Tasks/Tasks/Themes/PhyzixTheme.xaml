<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="clr-namespace:MdXaml;assembly=MdXaml">

  <!-- Неон / стекло (поверх SciFiTheme) -->
  <Color x:Key="Phyzix.Neon">#FF00E8FF</Color>
  <Color x:Key="Phyzix.NeonSoft">#6600E8FF</Color>
  <Color x:Key="Phyzix.BgVoid">#FF050810</Color>
  <Color x:Key="Phyzix.BgPanel">#E6121828</Color>
  <Color x:Key="Phyzix.GlassFill">#3328F6FF</Color>
  <Color x:Key="Phyzix.GlassBorder">#8800E8FF</Color>

  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Phyzix.Neon}" />
  <SolidColorBrush x:Key="Brush.BgDeep" Color="{StaticResource Phyzix.BgVoid}" />
  <SolidColorBrush x:Key="Brush.BgPanel" Color="#FF0C1424" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FF0A121F" />
  <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#FF111B2E" />
  <!-- Вторичный текст: светлее для читаемости на тёмных панелях -->
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#FFC5D4E8" />
  <SolidColorBrush x:Key="Brush.GlassFill" Color="{StaticResource Phyzix.GlassFill}" />
  <SolidColorBrush x:Key="Brush.GlassBorder" Color="{StaticResource Phyzix.GlassBorder}" />

  <DropShadowEffect x:Key="Effect.NeonGlow"
                    BlurRadius="18"
                    ShadowDepth="0"
                    Color="#FF00E8FF"
                    Opacity="0.85" />

  <DropShadowEffect x:Key="Effect.SoftGlow"
                    BlurRadius="28"
                    ShadowDepth="0"
                    Color="#FF00E8FF"
                    Opacity="0.35" />

  <!-- Тёмные основные кнопки: неоновая обводка и свечение, без «светлой таблетки» -->
  <Style x:Key="Phyzix.PrimaryActionButton" TargetType="Button">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="#FF0F1828" />
          <GradientStop Offset="1" Color="#FF0A101A" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="#CC00E8FF" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  CornerRadius="10"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#FF00E8FF" Opacity="0.55" />
            </Border.Effect>
            <ContentPresenter Margin="16,10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FF152238" />
                    <GradientStop Offset="1" Color="#FF0C1420" />
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#FF00F5FF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Phyzix.GhostLinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="6,4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Phyzix.CatalogListBox" TargetType="ListBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="#4400E8FF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
          <Setter Property="Margin" Value="0,6" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd"
                        Padding="10,10"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#3300E8FF"
                        Background="{StaticResource Brush.Surface}"
                        SnapsToDevicePixels="True"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                  <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#8800E8FF" />
                    <Setter TargetName="Bd" Property="Background" Value="#FF121C2E" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Bd" Property="Background" Value="#FF152238" />
                    <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Effect.NeonGlow}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Markdown: тёмная тема оформления документа -->
  <Style TargetType="md:MarkdownScrollViewer">
    <Setter Property="Background" Value="#FF080C14" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="MarkdownStyle" Value="{x:Static md:MarkdownStyle.Sasabune}" />
  </Style>

  <Style x:Key="Phyzix.ChoiceListBox" TargetType="ListBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
          <Setter Property="Margin" Value="0,6" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd"
                        Padding="12,10"
                        CornerRadius="10"
                        BorderBrush="#4400E8FF"
                        BorderThickness="1"
                        Background="{StaticResource Brush.Surface}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                  <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                    <Path x:Name="Check"
                          Grid.Column="1"
                          Width="18"
                          Height="18"
                          Margin="10,0,0,0"
                          Data="M2,10 L7,16 L16,4"
                          Stroke="{StaticResource Brush.Success}"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#AA00E8FF" />
                    <Setter TargetName="Bd" Property="Background" Value="#FF121C2E" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    <Setter TargetName="Bd" Property="Background" Value="#FF182440" />
                    <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Effect.SoftGlow}" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
