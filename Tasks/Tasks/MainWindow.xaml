<Window x:Class="PhysicsTasks.Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PhysicsTasks.Terminal.Views"
        xmlns:conv="clr-namespace:PhysicsTasks.Terminal.Converters"
        Title="Задачи · Phyzix"
        Background="{StaticResource Brush.BgDeep}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:AbsoluteFilePathToBitmapConverter x:Key="AbsPathToBitmap" />
    <conv:ZoomFactorToPercentConverter x:Key="ZoomToPercent" />
  </Window.Resources>
  <Grid Background="{StaticResource Brush.BgDeep}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Canvas Grid.RowSpan="1"
            Panel.ZIndex="0"
            IsHitTestVisible="False"
            Opacity="0.07">
      <Canvas.RenderTransform>
        <ScaleTransform ScaleX="1.15" ScaleY="1.15" CenterX="600" CenterY="400" />
      </Canvas.RenderTransform>
      <Path Data="M40,120 L880,40 L920,200 L120,260 Z"
            Fill="#2200E8FF"
            Stroke="#3300E8FF"
            StrokeThickness="0.6" />
      <Path Data="M900,520 C760,360 620,760 400,620 S160,520 80,640"
            Stroke="#2200E8FF"
            StrokeThickness="0.8" />
      <Ellipse Canvas.Left="980"
               Canvas.Top="120"
               Width="140"
               Height="140"
               Stroke="#1900E8FF"
               StrokeThickness="1" />
      <Path Data="M1020,360 L1080,420 L1040,480 L980,420 Z"
            Fill="#1500E8FF"
            Stroke="#2200E8FF"
            StrokeThickness="0.5" />
    </Canvas>

    <!-- Только закрытие окна; заголовок и статус-строка убраны как лишние. -->
    <Button Grid.Row="0"
            Panel.ZIndex="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,10,14,0"
            Content="✕"
            ToolTip="Закрыть"
            Click="CloseWindowButton_Click"
            Padding="12,8"
            MinWidth="44"
            MinHeight="36"
            FontSize="16"
            FontWeight="SemiBold"
            Cursor="Hand"
            Foreground="{StaticResource Brush.Accent}"
            Background="#2200E8FF"
            BorderBrush="#5500E8FF"
            BorderThickness="1" />

    <views:TaskWorkspaceView x:Name="Workspace"
                             Grid.Row="0"
                             Panel.ZIndex="1"
                             Margin="10,8,10,10" />

    <!-- Полноэкранный просмотр фото / PDF (поверх всего окна) -->
    <Grid Grid.Row="0"
          Panel.ZIndex="80"
          Background="#F0080C14"
          Visibility="{Binding IsFullscreenOpen, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0"
                 Margin="16,12,16,8"
                 LastChildFill="False">
        <TextBlock DockPanel.Dock="Left"
                   VerticalAlignment="Center"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#D0FFFFFF">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="Фотография" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullscreenPdf}" Value="True">
                  <Setter Property="Text" Value="Методичка (PDF)" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Button DockPanel.Dock="Right"
                MinWidth="120"
                Padding="14,8"
                Command="{Binding CloseFullscreenMediaCommand}"
                Content="✕  Закрыть"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="{StaticResource Brush.Accent}"
                Style="{StaticResource Phyzix.GhostLinkButton}"
                ToolTip="Закрыть (Esc)" />
      </DockPanel>

      <StackPanel Grid.Row="1"
                  Margin="12,4,12,0"
                  HorizontalAlignment="Center"
                  Orientation="Horizontal">
        <Button MinWidth="44"
                Command="{Binding ZoomFullscreenOutCommand}"
                Content="−"
                FontSize="18"
                FontWeight="SemiBold"
                Style="{StaticResource Phyzix.GhostLinkButton}"
                ToolTip="Отдалить" />
        <Button MinWidth="44"
                Margin="6,0,0,0"
                Command="{Binding ZoomFullscreenInCommand}"
                Content="+"
                FontSize="18"
                FontWeight="SemiBold"
                Style="{StaticResource Phyzix.GhostLinkButton}"
                ToolTip="Приблизить" />
        <Button MinWidth="72"
                Margin="12,0,0,0"
                Command="{Binding ResetFullscreenViewCommand}"
                Content="{Binding FullscreenZoom, Converter={StaticResource ZoomToPercent}}"
                Foreground="{StaticResource Brush.Text}"
                Style="{StaticResource Phyzix.GhostLinkButton}"
                ToolTip="Сбросить масштаб и положение (к 100%)" />
      </StackPanel>

      <views:ZoomPanHost Grid.Row="2"
                         Margin="12,8,12,8"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         MinHeight="200"
                         PanX="{Binding FullscreenPanX, Mode=TwoWay}"
                         PanY="{Binding FullscreenPanY, Mode=TwoWay}"
                         Zoom="{Binding FullscreenZoom}">
        <Grid MinHeight="200"
              Background="{StaticResource Brush.Surface}">
          <Image HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Stretch="Uniform"
                 Visibility="{Binding IsFullscreenPhoto, Converter={StaticResource BoolToVis}}"
                 Source="{Binding TaskImageAbsolutePath, Converter={StaticResource AbsPathToBitmap}}" />
          <Image HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Stretch="Uniform"
                 Visibility="{Binding IsFullscreenPdf, Converter={StaticResource BoolToVis}}"
                 Source="{Binding PdfPageImage}" />
        </Grid>
      </views:ZoomPanHost>

      <StackPanel Grid.Row="3"
                  Margin="0,8,0,20"
                  HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsFullscreenPdf, Converter={StaticResource BoolToVis}}">
          <Button MinWidth="120"
                  Command="{Binding PdfPrevPageCommand}"
                  Content="◀ Назад"
                  Style="{StaticResource Phyzix.GhostLinkButton}" />
          <TextBlock Margin="18,0"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource Brush.Text}"
                     Text="{Binding PdfPageLabel}" />
          <Button MinWidth="120"
                  Command="{Binding PdfNextPageCommand}"
                  Content="Вперёд ▶"
                  Style="{StaticResource Phyzix.GhostLinkButton}" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="#668899AA"
                   Text="Esc — выйти из полноэкранного режима"
                   Visibility="{Binding IsFullscreenOpen, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
