<UserControl x:Class="ForTeacher.Controls.DifficultyRatingStars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="36">
  <StackPanel x:Name="StarsRow" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="S1" Tag="1" Click="Star_Click" Style="{StaticResource HudGhostButton}" Padding="4,2" Margin="0,0,2,0" FontSize="22" BorderThickness="0" Background="Transparent" Cursor="Hand" Content="★"/>
    <Button x:Name="S2" Tag="2" Click="Star_Click" Style="{StaticResource HudGhostButton}" Padding="4,2" Margin="0,0,2,0" FontSize="22" BorderThickness="0" Background="Transparent" Cursor="Hand" Content="★"/>
    <Button x:Name="S3" Tag="3" Click="Star_Click" Style="{StaticResource HudGhostButton}" Padding="4,2" Margin="0,0,2,0" FontSize="22" BorderThickness="0" Background="Transparent" Cursor="Hand" Content="★"/>
    <Button x:Name="S4" Tag="4" Click="Star_Click" Style="{StaticResource HudGhostButton}" Padding="4,2" Margin="0,0,2,0" FontSize="22" BorderThickness="0" Background="Transparent" Cursor="Hand" Content="★"/>
    <Button x:Name="S5" Tag="5" Click="Star_Click" Style="{StaticResource HudGhostButton}" Padding="4,2" Margin="0,0,8,0" FontSize="22" BorderThickness="0" Background="Transparent" Cursor="Hand" Content="★"/>
    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource HudTextMutedBrush}" Text="(можно изменить вручную)"/>
  </StackPanel>
</UserControl>
