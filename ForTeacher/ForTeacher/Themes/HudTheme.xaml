<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wt="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">

    <Color x:Key="HudBgDeep">#0B0E14</Color>
    <Color x:Key="HudBgPanel">#121826</Color>
    <Color x:Key="HudBgElevated">#1A2233</Color>
    <Color x:Key="HudBgInput">#0F1522</Color>
    <Color x:Key="HudBorderDim">#2A3348</Color>
    <Color x:Key="HudTextPrimary">#E8FFF0</Color>
    <Color x:Key="HudTextMuted">#9BB0C8</Color>
    <Color x:Key="HudAccentLime">#B5FF39</Color>
    <Color x:Key="HudAccentCyan">#4AF2E8</Color>
    <Color x:Key="HudDanger">#FF7A5C</Color>

    <SolidColorBrush x:Key="HudBgDeepBrush" Color="{StaticResource HudBgDeep}"/>
    <SolidColorBrush x:Key="HudBgPanelBrush" Color="{StaticResource HudBgPanel}"/>
    <SolidColorBrush x:Key="HudBgElevatedBrush" Color="{StaticResource HudBgElevated}"/>
    <SolidColorBrush x:Key="HudBgInputBrush" Color="{StaticResource HudBgInput}"/>
    <SolidColorBrush x:Key="HudBorderDimBrush" Color="{StaticResource HudBorderDim}"/>
    <SolidColorBrush x:Key="HudTextPrimaryBrush" Color="{StaticResource HudTextPrimary}"/>
    <SolidColorBrush x:Key="HudTextMutedBrush" Color="{StaticResource HudTextMuted}"/>
    <SolidColorBrush x:Key="HudAccentLimeBrush" Color="{StaticResource HudAccentLime}"/>
    <SolidColorBrush x:Key="HudAccentCyanBrush" Color="{StaticResource HudAccentCyan}"/>
    <SolidColorBrush x:Key="HudDangerBrush" Color="{StaticResource HudDanger}"/>
    <SolidColorBrush x:Key="HudNavActiveBrush" Color="#1E2638"/>

    <LinearGradientBrush x:Key="HudPanelGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#151C2A" Offset="0"/>
        <GradientStop Color="#101521" Offset="1"/>
    </LinearGradientBrush>

    <wt:BooleanToVisibilityConverter x:Key="HudBoolToVisibility"/>

    <!-- Сетка на фоне панели -->
    <DrawingBrush x:Key="HudGridPatternBrush" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Opacity="0.12">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource HudAccentCyanBrush}" Thickness="0.35"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="48,0"/>
                        <LineGeometry StartPoint="0,0" EndPoint="0,48"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="HudWindowChrome" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource HudBgDeepBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="WindowState" Value="Maximized"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
    </Style>

    <Style x:Key="HudCaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HudTextMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="HudTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="HudSubTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HudAccentCyanBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style x:Key="HudGridTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Не задаём Foreground для всех TextBlock: иначе перебивается наследование от Button (текст на лаймовых кнопках). -->

    <Style x:Key="HudGlowBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HudPanelGlowBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="HudPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#0B0E14"/>
        <Setter Property="Background" Value="{StaticResource HudAccentLimeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudAccentLimeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="#0B0E14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#B5FF39" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D4FF7A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudSecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource HudAccentCyanBrush}"/>
        <Setter Property="Background" Value="{StaticResource HudBgElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudAccentCyanBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource HudAccentCyanBrush}"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#4AF2E8" BlurRadius="10" ShadowDepth="0" Opacity="0.25"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#222C40"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudDangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource HudDangerBrush}"/>
        <Setter Property="Background" Value="#221418"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudDangerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource HudDangerBrush}"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF7A5C" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A1820"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudGhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A2233"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HudAccentLimeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudSidebarButton" TargetType="Button" BasedOn="{StaticResource HudGhostButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#243049"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2D44"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тёмный шаблон: без «светлой» системной полосы и белого текста на ней -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource HudBgInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="TbBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TbBd" Property="Background" Value="#141C2E"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TbBd" Property="BorderBrush" Value="{StaticResource HudAccentCyanBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <DockPanel LastChildFill="True" Margin="0">
                                <Path DockPanel.Dock="Right" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="10" Height="7" Margin="10,0,2,0" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                            </DockPanel>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" PopupAnimation="Fade" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}"
                                    MaxHeight="320"
                                    Background="#121826"
                                    BorderBrush="{StaticResource HudBorderDimBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,4,0,0">
                                <ScrollViewer Margin="4,4,4,4" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource HudBgInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource HudAccentLimeBrush}"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource HudBgInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource HudAccentLimeBrush}"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="HudDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource HudTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="#141A28"/>
        <Setter Property="AlternatingRowBackground" Value="#101521"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="64"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#161C2A"/>
        <Setter Property="Foreground" Value="{StaticResource HudAccentCyanBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1B2436"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#22304A"/>
                <Setter Property="BorderBrush" Value="{StaticResource HudAccentLimeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Вкладки рабочей области (список / добавление) -->
    <Style x:Key="HudWorkspaceTabItem" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource HudTextMutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" CornerRadius="12,12,0,0" Padding="22,12" Margin="0,0,8,-1"
                            Background="#121826" BorderBrush="{StaticResource HudBorderDimBrush}" BorderThickness="1,1,1,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#151C2A"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource HudAccentLimeBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HudAccentLimeBrush}"/>
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#B5FF39" BlurRadius="18" ShadowDepth="0" Opacity="0.42"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.96"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudWorkspaceTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6,10,0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource HudWorkspaceTabItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" Margin="4,0,4,0" Background="Transparent"/>
                        <Border Grid.Row="1" Margin="4,0,4,8" Padding="2"
                                Background="#0E121C" BorderBrush="{StaticResource HudBorderDimBrush}" BorderThickness="1"
                                CornerRadius="0,0,14,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Margin="6" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudFieldShell" TargetType="Border">
        <Setter Property="Background" Value="#0F1522"/>
        <Setter Property="BorderBrush" Value="{StaticResource HudBorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="HudImageDropZoneButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource HudAccentLimeBrush}"/>
        <Setter Property="Background" Value="#0B101C"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource HudAccentLimeBrush}"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource HudAccentLimeBrush}" StrokeThickness="1.6"
                                   StrokeDashArray="6 4" Fill="#0B101C"/>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#B5FF39" BlurRadius="14" ShadowDepth="0" Opacity="0.22"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#151C2A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudOverlayPickButton" TargetType="Button" BasedOn="{StaticResource HudGhostButton}">
        <Setter Property="Opacity" Value="0.92"/>
        <Setter Property="Background" Value="#CC0E121C"/>
    </Style>

    <Style x:Key="HudSaveTaskButton" TargetType="Button" BasedOn="{StaticResource HudPrimaryButton}">
        <Setter Property="Padding" Value="22,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#B5FF39" BlurRadius="22" ShadowDepth="0" Opacity="0.65"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D4FF7A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
