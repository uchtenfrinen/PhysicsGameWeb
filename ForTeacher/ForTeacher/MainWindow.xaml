<Window x:Class="ForTeacher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ForTeacher.Views"
        Title="Модуль преподавателя"
        Style="{StaticResource HudWindowChrome}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Верхняя панель: только заголовок и закрытие -->
    <Border Grid.Row="0"
            Padding="20,14"
            Background="#0E121C"
            BorderBrush="{StaticResource HudBorderDimBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Text="Модуль преподавателя"
                   Style="{StaticResource HudTitleText}" />
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="CloseWindowButton_Click"
                Content="✕"
                Cursor="Hand"
                FontSize="15"
                Margin="0"
                MinWidth="40"
                Padding="12,6"
                Style="{StaticResource HudGhostButton}"
                ToolTip="Закрыть" />
      </Grid>
    </Border>

    <!-- Контент -->
    <Border Grid.Row="1"
            Background="{StaticResource HudBgDeepBrush}"
            Padding="0">
      <Grid>
        <Border Background="{StaticResource HudGridPatternBrush}"
                IsHitTestVisible="False"
                Opacity="0.35" />
        <Border Margin="18"
                Padding="0"
                Style="{StaticResource HudGlowBorder}">
          <views:TeacherWorkspaceView />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
