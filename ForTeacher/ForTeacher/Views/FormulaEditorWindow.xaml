<Window x:Class="ForTeacher.Views.FormulaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:math="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Редактор формулы"
        SizeToContent="WidthAndHeight"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource HudBgDeepBrush}"
        Foreground="{StaticResource HudTextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Border Background="{StaticResource HudBgDeepBrush}"
            BorderBrush="{StaticResource HudBorderDimBrush}"
            BorderThickness="1">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="-14,-14,-14,12"
                Padding="14,10"
                Background="#0E121C"
                BorderBrush="{StaticResource HudBorderDimBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Text="Редактор формулы"
                           Style="{StaticResource HudSubTitleText}" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="40"
                        Padding="12,6"
                        Click="CloseButton_Click"
                        Content="✕"
                        Cursor="Hand"
                        FontSize="15"
                        Style="{StaticResource HudGhostButton}"
                        ToolTip="Закрыть" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="Введите формулу в LaTeX-стиле (как в Word Equation)."
                   Margin="0,0,0,8"
                   Foreground="{StaticResource HudTextPrimaryBrush}"
                   TextWrapping="Wrap" />

        <TextBox x:Name="FormulaInputBox"
                 Grid.Row="2"
                 MinHeight="110"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="15" />

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                BorderBrush="{StaticResource HudBorderDimBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{StaticResource HudBgInputBrush}">
            <math:FormulaControl Formula="{Binding Text, ElementName=FormulaInputBox}"
                                 Foreground="#EAF7FF"
                                 FontSize="18" />
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource HudTextMutedBrush}"
                       Text="В текст будет вставлено как: $...$" />
            <Button x:Name="CancelButton"
                    DockPanel.Dock="Right"
                    Width="100"
                    Margin="8,0,0,0"
                    Style="{StaticResource HudSecondaryButton}"
                    Content="Отмена"
                    IsCancel="True" />
            <Button x:Name="InsertButton"
                    DockPanel.Dock="Right"
                    Width="100"
                    Style="{StaticResource HudPrimaryButton}"
                    Content="Вставить"
                    IsDefault="True" />
        </DockPanel>
    </Grid>
    </Border>
</Window>
