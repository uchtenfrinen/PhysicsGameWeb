<Window
    x:Class="ForTeacher.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Вход · преподаватель"
    Style="{StaticResource HudWindowChrome}">
    <Grid>
        <Border
            Background="{StaticResource HudGridPatternBrush}"
            IsHitTestVisible="False"
            Opacity="0.25" />
        <Button
            MinWidth="44"
            MinHeight="36"
            Margin="16,16,20,0"
            Padding="12,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="2"
            Click="CloseButton_Click"
            Content="✕"
            Cursor="Hand"
            FontSize="16"
            Style="{StaticResource HudGhostButton}"
            ToolTip="Закрыть" />
        <Border
            Margin="28"
            VerticalAlignment="Center"
            Style="{StaticResource HudGlowBorder}">
            <StackPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="20"
                    Style="{StaticResource HudTitleText}"
                    Text="Доступ преподавателя" />
                <TextBlock
                    Margin="0,10,0,16"
                    Style="{StaticResource HudCaptionText}"
                    Text="Пароль действует только в этом сеансе и не сохраняется между запусками."
                    TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource HudCaptionText}" Text="Пароль" />
                <PasswordBox
                    x:Name="PasswordField"
                    MinHeight="38"
                    Margin="0,4,0,18"
                    PasswordChanged="PasswordField_OnPasswordChanged" />

                <Button
                    Padding="22,10"
                    HorizontalAlignment="Right"
                    Command="{Binding LoginCommand}"
                    Content="Войти"
                    IsDefault="True"
                    Style="{StaticResource HudPrimaryButton}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
